# Application Configuration
APP_ENV=development
APP_PORT=8081
APP_BASE_URL=http://YOUR_LAN_IP:8081
FRONTEND_URL=http://YOUR_LAN_IP:3000

# Database Configuration
$env:DATABASE_URL="postgres://user:password@localhost:5432/dbname?sslmode=disable"
$env:SESSION_SECRET="your-32-character-or-longer-secret-key-here"
$env:APP_ENV="development"
$env:APP_PORT="8081"

# Session Configuration
SESSION_SECRET=your-32-character-or-longer-secret-key-here
SESSION_TTL_HOURS=24

# System Administrator Emails (comma-separated)
SYSTEM_ADMIN_EMAILS=admin@example.com

# Azure AD Configuration (optional SSO provider)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URL=http://YOUR_LAN_IP:8081/auth/azure/callback

# Microsoft Graph / SharePoint Configuration
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=contoso.sharepoint.com:/sites/Projects
SHAREPOINT_ROOT_FOLDER=/Flowie
